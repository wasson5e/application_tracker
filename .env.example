# API Service
# Port the Express API server listens on (integer, 1–65535)
API_PORT=4000

# MongoDB connection URI (include host, port, and any auth credentials)
MONGODB_URI=mongodb://db:27017

# MongoDB database name
DB_NAME=job_tracker

# UI Service
# Port the Nginx UI container is exposed on
UI_PORT=3000

# Resume Storage
# Absolute path to the local folder where resumes are stored.
# This folder is mounted into the API container at /data/resumes.
RESUME_LOCAL_PATH=./resumes
